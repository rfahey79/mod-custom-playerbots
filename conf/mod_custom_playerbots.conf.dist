# Persistent custom Altbots for the Playerbot-compatible AzerothCore branch.
# These accounts must NOT use AiPlayerbot.RandomBotAccountPrefix.

CustomPlayerbots.Enable = 1

# Wait until world startup is fully settled before logging roster members in.
CustomPlayerbots.AutoLoginDelayMs = 15000

# Maximum roster bots whose login is started in a single world tick.
CustomPlayerbots.AutoLoginBatchSize = 5

# Enable autonomous questing for newly created and registered custom bots.
# Existing bots retain their stored setting; use `.custombot autonomous all on|off`
# to change an existing roster.
CustomPlayerbots.AutonomousByDefault = 1

# Let one online custom bot greet a real guild member when they log in.
CustomPlayerbots.GuildGreeting.Enable = 0

# Percentage chance that an eligible login receives a greeting.
CustomPlayerbots.GuildGreeting.Chance = 100

# Random delay before the greeting is sent, in milliseconds.
CustomPlayerbots.GuildGreeting.MinDelayMs = 3000
CustomPlayerbots.GuildGreeting.MaxDelayMs = 9000

# Pipe-separated greetings for regular members. Use {player} for their name.
# MemberMessages overrides this setting when supplied.
CustomPlayerbots.GuildGreeting.Messages = "Welcome back, {player}!|Good to see you, {player}!|{player} is back in action!"

# Guild ranks count upward from 0 (guildmaster). Ranks from 1 through this
# value use OfficerMessages; all higher ranks use MemberMessages.
CustomPlayerbots.GuildGreeting.OfficerMaxRank = 1

# Rank-aware message pools. Leave MemberMessages blank to keep using Messages.
CustomPlayerbots.GuildGreeting.LeaderMessages = "The boss is back: {player}!|Make way, {player} has returned.|The guildmaster has arrived. Try to look busy, {player}!"
CustomPlayerbots.GuildGreeting.OfficerMessages = "Officer {player} is back. The paperwork can wait.|{player} is online—someone hide the guild bank keys.|Welcome back, {player}; leadership looks exhausting."
CustomPlayerbots.GuildGreeting.MemberMessages = "Welcome back, {player}!|Good to see you, {player}!|{player} is back in action!"
